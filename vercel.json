{
  "functions": {
    "api/avatars.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?__ba=:path*"
    },
    {
      "source": "/api/leads",
      "destination": "/api/lead-capture"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
